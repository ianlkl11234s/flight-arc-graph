# Cloudflare Workers 靜態資產的 header（對應原 nginx.conf 的快取政策）
/assets/*
  Cache-Control: public, max-age=604800, immutable
/airports/*
  Cache-Control: no-cache
/notes/*
  Cache-Control: no-cache
# 含中文的純文字檔帶 charset，避免爬蟲以 Latin-1 解讀（同 nginx 的 charset utf-8）
/robots.txt
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
